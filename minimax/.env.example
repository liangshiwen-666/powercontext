# Copy to .env and fill in real values. NEVER commit a filled .env.

# --- MiniMax (only needed for `python -m sddctx run --live` / `patch generate --live`) ---
MINIMAX_API_KEY=sk-your-key-here
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_REASONING_EFFORT=high
MINIMAX_MAX_COMPLETION_TOKENS=131072

# --- seekdb (MySQL protocol) ---
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=sddctx
# Or use embedded seekdb (Linux/macOS only) instead of a server:
# SDDCTX_SEEKDB_EMBEDDED_DIR=/abs/path/to/seekdb-data

# --- optional overrides ---
# SDDCTX_ROOT=/abs/path/to/minimax
# SDDCTX_DEMO=/abs/path/to/demo
# SDDCTX_DATA=/abs/path/to/.data
# SDDCTX_PYTHON=/abs/path/to/.venv/bin/python

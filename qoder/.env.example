# ===== LLM（OpenAI 兼容接口，可填任意供应商）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 文本向量 =====
# auto: 有 EMBEDDING_API_KEY 就用接口模型，否则用 pyseekdb 内置本地模型
# local: 强制使用内置 all-MiniLM-L6-v2（384 维，无需 Key，中文语义较弱）
# api:   强制使用 OpenAI 兼容 /embeddings 接口
EMBEDDING_MODE=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 本地模型首次运行会从 Hugging Face 下载约 86MB；国内网络可取消下一行注释
# HF_ENDPOINT=https://hf-mirror.com

# ===== seekdb =====
# embedded: 嵌入式（Linux/macOS）
# remote:   连接 seekdb Server / Docker（Windows 用这个）
SEEKDB_MODE=embedded
SEEKDB_PATH=./data/seekdb
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=study_coach

# ===== PowerContext =====
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
POWERCONTEXT_SCOPE_PREFIX=study-coach

# ===== 应用（WSL / Linux 生效；Windows 用 $env:APP_HOST 设置）=====
APP_PORT=8080
# 默认仅本机；可信局域网试用可改为 0.0.0.0，勿暴露公网
APP_HOST=127.0.0.1

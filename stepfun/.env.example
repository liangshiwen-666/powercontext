# HTTP API of the local Node service (the browser talks to this).
PORT=8787
HOST=127.0.0.1

# --- seekdb ---
# Backend is auto-detected at startup:
#   1. SEEKDB_MODE=server|embedded  (explicit)
#   2. SEEKDB_HOST set              (server)
#   3. otherwise: probe 127.0.0.1:2881 -> server if reachable, else embedded
# Leave SEEKDB_MODE unset to get "Docker if present, embedded if not".
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=stepfun
# How long the startup probe waits before falling back to embedded (ms).
SEEKDB_PROBE_TIMEOUT_MS=600

# Force one backend (also available as CLI flags --server / --embedded):
# SEEKDB_MODE=embedded
# SEEKDB_MODE=server

# Embedded data directory (single-writer; one process).
SEEKDB_PATH=./stepfun-data/seekdb
# Set to 1 to kill a leftover embedded instance holding the data directory.
# SEEKDB_FORCE_UNLOCK=0

DEFAULT_COLLECTION=kb
# Physical collection holding every logical collection (partitioned by metadata).
SEEKDB_COLLECTION=kb_docs

# "immediate" (default) indexes writes synchronously; "async" needs server mode
# plus refresh_index() to make new rows searchable.
SEEKDB_SYNC_MODE=immediate

# --- embedding model (browser side) ---
EMBED_MODEL_ID=Xenova/bge-small-zh-v1.5
EMBED_DIM=512
# Mirror used when the model is not vendored under web/public/models.
# VITE_MODEL_HOST=https://hf-mirror.com

# Set to 1 to write server/db.trace.log for debugging.
# DEBUG_DB=0

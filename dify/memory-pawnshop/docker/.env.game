# ==================================================================
# 记忆当铺 · 叠加到 Dify docker/.env 的配置（追加在 .env.example 之后）
# ==================================================================

# --- Dify 基础 ---
# 生产环境请务必换成自己的随机串：openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32-byte-hex-string
EXPOSE_NGINX_PORT=3000
MIGRATION_ENABLED=true
LOG_LEVEL=INFO

# 只用 postgres，不启动 Dify 的向量库容器（本作品不使用 Dify 知识库）
VECTOR_STORE=seekdb
COMPOSE_PROFILES=postgresql
ENABLE_COLLABORATION_MODE=false

# Dify 1.18 要求：本地 sandbox 需要非空 token
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=change-me-to-a-random-sandbox-token

# Dify 的 HTTP Request 节点默认走 SSRF 代理，需放行私网地址段，
# 否则无法访问 compose 网络内的 powercontext:8000
SSRF_PROXY_ALLOW_PRIVATE_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- PowerContext（powercontext 容器） ---
# 硅基流动 API Key：供 PowerContext 调用 BAAI/bge-m3 做向量检索
GAME_SILICONFLOW_API_KEY=sk-REPLACE_WITH_YOUR_SILICONFLOW_KEY
